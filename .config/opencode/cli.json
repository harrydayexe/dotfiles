{
  "$schema": "https://opencode.ai/v2/cli.json",
  "theme": {
    "name": "catppuccin",
    "mode": "dark"
  },
  "animations": false,
  "session": {
    "scrollbar": false,
    "thinking": "hide",
    "markdown": "rendered",
    "grouping": "auto",
    "verbosity": "low",
    "new_location": "launch",
    "permissions": "prompt"
  },
  "tabs": {
    "mode": "auto",
    "scope": "cwd"
  },
  "prompt": {
    "editor": true
  },
  "attention": {
    "notifications": true
  },
  "highlights": true,
  "terminal": {
    "copy": "manual"
  },
  "plugins": [
    {
      "package": "vimcode@git+https://github.com/oribarilan/vimcode.git#v0.19.2"
    }
  ]
}
